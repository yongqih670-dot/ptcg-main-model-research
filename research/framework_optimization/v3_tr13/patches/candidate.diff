+class ObservedCall:
+    def __init__(self,observer):self.observer=observer
+    def __enter__(self):return self.observer
+    def __exit__(self,kind,error,tb):
+        if error is not None:self.observer.failed(error)
+        else:self.observer.finish()
+        return False
